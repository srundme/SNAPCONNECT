# Local placeholders only. Generate real secrets with: openssl rand -base64 32
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
PRODUCT_NAME=SnapServe Social

POSTGRES_USER=snapsocial
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=snapsocial
DATABASE_URL=postgresql://snapsocial:replace-with-a-local-password@localhost:5432/snapsocial

REDIS_URL=redis://127.0.0.1:6379

BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000

# 32-byte key, base64. Example generation: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key
CREDENTIAL_ENCRYPTION_KEY_ID=local-1

# Shared or separate Meta apps. Leave blank until you connect a real app.
# A shared app is recorded by using the same app id in both channel configs.
META_API_VERSION=v23.0
META_INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
META_FACEBOOK_GRAPH_BASE_URL=https://graph.facebook.com
META_INSTAGRAM_OAUTH_BASE_URL=https://www.instagram.com
META_FACEBOOK_OAUTH_BASE_URL=https://www.facebook.com
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_VERIFY_TOKEN=
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
META_FACEBOOK_VERIFY_TOKEN=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_SCOPES=ZohoCRM.modules.leads.READ,ZohoCRM.modules.leads.CREATE,ZohoCRM.modules.leads.UPDATE,ZohoCRM.settings.fields.READ

OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:2b
LLM_CONTEXT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=400
LLM_CONCURRENCY=1
# fixture = labelled local extractor for development. ollama = local model. sarvam = Sarvam conversation API.
# An ollama or Sarvam failure never falls back to fixture.
LLM_MODE=fixture
SARVAM_API_KEY=
GOOGLE_PLACES_API_KEY=
BRAVE_SEARCH_API_KEY=

DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_PHONE_REGION=IN
